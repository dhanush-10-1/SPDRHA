# Configure runtime secrets in Render later. Do not commit populated values.
# Public test service settings:
POC_LAPTOP_TS_IP=100.64.0.1
TAILSCALE_AUTHKEY_FILE=/etc/secrets/tailscale-authkey
# Passwords must match only the isolated Windows stack; >=24 characters each.
POC_DB_PASSWORD=
POC_REDIS_PASSWORD=
POC_PROBE_TOKEN=
# Add a Render secret file named tailscale-authkey containing ONLY the auth key.
# Render supplies PORT. No disk, privileged mode, TUN device, or public TCP ports needed.
